# pxrepo 配置模板
#
# 用法：复制为 .env 后填写（.env 不入库）
#   cp env.example .env
#
# 优先级：命令行参数 > 真实环境变量 > .env 文件 > 内置默认值
# 变量前缀固定 PXREPO_

# ── 必填 ───────────────────────────────────────────────────────────────
# 下载输出根目录（支持 ~ 展开；不配置则下载类命令会明确报错）
PXREPO_DATA_ROOT=~/Pixiv

# ── 登录 ───────────────────────────────────────────────────────────────
# 方式一（推荐，功能最全）：App API 的 refresh_token
#   执行 `node cli.js --login` 成功后自动写入本文件；也可手工粘贴旧凭据。
#   注意：`--login` 走 OAuth PKCE，需要「能访问 Pixiv 的浏览器」完成授权；
#         若浏览器打不开 Pixiv，请改用方式二。
PXREPO_REFRESH_TOKEN=

# 方式二（推荐给「只有账号密码」的用户）：Cookie 登录
#   从浏览器取会话 Cookie：登录 pixiv.net → F12 → Application → Cookies → 复制
#   （形如 PHPSESSID=xxxx; yuid_b=yyy），粘到下面。有了它 `node cli.js -p <PID>`
#   就能下载 R-18 等「未登录拿不到图片地址」的作品，且不需要 App API token。
#   凭据只在本机 .env（已 gitignore），绝不入库。
PXREPO_COOKIE=
# 也可指定 Cookie 文件（默认 <状态目录>/web-session.json，由 test/pixiv-web-login.mjs 写入）
PXREPO_COOKIE_FILE=

# 方式三：网页会话自动登录（无头浏览器，需能访问 Pixiv 的代理）
#   Pixiv 已废除 App API 的账号密码授权（实测 password grant 返回 invalid_grant），
#   所以账号密码只能走网页登录：PXREPO_PIXIV_ID / PXREPO_PIXIV_PASSWORD 填在下面，
#   再执行 `node test/pixiv-web-login.mjs` 取会话 Cookie（脚本不保存密码）
PXREPO_PIXIV_ID=
PXREPO_PIXIV_PASSWORD=

# ── 下载行为 ───────────────────────────────────────────────────────────
# 并发下载数（默认 5）
PXREPO_CONCURRENCY=5

# 每秒请求上限（默认 1；0 = 不限速）
PXREPO_TPS=1

# 单请求超时（毫秒，默认 30000）
PXREPO_TIMEOUT_MS=30000

# 失败重试次数（默认 3；指数退避）
PXREPO_RETRIES=3

# ── 网络 ───────────────────────────────────────────────────────────────
# http(s) 代理；留空 = 直连；写 disable = 强制忽略系统代理环境变量
PXREPO_PROXY=

# 硬编码 IP 直连（1 = 启用，连不上时自动回退系统 DNS；默认 0）
PXREPO_HTTPDNS=0

# ── 界面 ───────────────────────────────────────────────────────────────
# 进度条样式：single（单行汇总）| multi（每任务一行，默认）| ipull（图标+列对齐）
PXREPO_PROGRESS=multi

# ── 状态文件 ───────────────────────────────────────────────────────────
# 黑名单 / 待下载清单 / 历史记录 的存放目录（默认：数据根下的 .pxrepo）
# PXREPO_STATE_DIR=~/Pixiv/.pxrepo

# 黑名单文件路径（默认 <状态目录>/blacklist.json）
# 语义：下载时跳过这些作者（JSON 数组 [{"id":123}]）；用 `node cli.js -l 123` 增删
# PXREPO_BLACKLIST=~/Pixiv/.pxrepo/blacklist.json
